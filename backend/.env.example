# Required - generation calls (Groq: https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here

# Optional - question-history persistence (Neon Postgres: https://neon.tech).
# The app runs fine without this; history just won't survive a restart.
DATABASE_URL=postgresql://user:password@your-endpoint.region.aws.neon.tech/dbname?sslmode=require

# Optional - only needed to run in hosted embedding mode instead of the
# default local mode. Leave both unset to use the local model (no API key
# needed, just installs sentence-transformers/torch).
# EMBEDDING_PROVIDER=huggingface
# HUGGINGFACE_API_KEY=your-huggingface-token-here

# Optional - only relevant when deploying the backend somewhere other than
# localhost, so CORS allows the real deployed frontend origin.
# FRONTEND_ORIGIN=http://localhost:5173
